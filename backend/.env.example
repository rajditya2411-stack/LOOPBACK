# LoopBack Backend Environment Variables

# Database
LOOPBACK_DATABASE_URL=sqlite+aiosqlite:///./loopback.db

# JWT
# Required in every environment. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the generated value after the equals sign; do not commit your .env file.
LOOPBACK_JWT_SECRET_KEY=
LOOPBACK_JWT_ALGORITHM=HS256
LOOPBACK_ACCESS_TOKEN_EXPIRE_MINUTES=30
LOOPBACK_REFRESH_TOKEN_EXPIRE_DAYS=7
# Leave unset to require HTTPS whenever LOOPBACK_DEBUG=false. Set to false
# only for an intentionally local HTTP deployment such as Docker Compose.
# LOOPBACK_AUTH_COOKIE_SECURE=false

# AI keys are intentionally absent. Each account configures its own supported
# provider and key after signing in; the browser never receives stored keys.

# Storage
LOOPBACK_UPLOAD_DIR=uploads
LOOPBACK_MAX_UPLOAD_SIZE_MB=50
LOOPBACK_CHROMA_PERSIST_DIR=chroma
LOOPBACK_DOCUMENT_CHUNK_SIZE=1200
LOOPBACK_DOCUMENT_CHUNK_OVERLAP=200
LOOPBACK_RAG_MAX_CHUNKS=4
LOOPBACK_RAG_MAX_CONTEXT_CHARS=12000
LOOPBACK_RAG_MAX_CONTEXT_TOKENS=3000
LOOPBACK_RAG_MIN_RELEVANCE=0.15
LOOPBACK_CHAT_MAX_HISTORY_MESSAGES=20
LOOPBACK_CHAT_MAX_HISTORY_TOKENS=4000
LOOPBACK_WORKSPACE_CONTEXT_MAX_CHARS=6000
LOOPBACK_WORKSPACE_CONTEXT_MAX_ITEMS=12
LOOPBACK_MEMORY_EXTRACTION_MAX_ITEMS=5
LOOPBACK_MEMORY_EXTRACTION_MIN_CONFIDENCE=0.7
LOOPBACK_MEMORY_EXTRACTION_MAX_TURN_CHARS=8000

# Email (leave SMTP_HOST empty to use backend/uploads/outbox in local development)
LOOPBACK_SMTP_HOST=
LOOPBACK_SMTP_PORT=587
LOOPBACK_SMTP_USERNAME=
LOOPBACK_SMTP_PASSWORD=
LOOPBACK_SMTP_FROM_EMAIL=noreply@loopback.local
LOOPBACK_SMTP_USE_TLS=true

# CORS
LOOPBACK_FRONTEND_URL=http://localhost:3000

# App
LOOPBACK_APP_NAME=LoopBack
LOOPBACK_APP_VERSION=0.1.0
LOOPBACK_DEBUG=true
